# Environment Configuration
# Set this to "prod" for production/master branch, or "local" for local/test environments
NEXT_PUBLIC_APP_ENV=local

# Options:
# - "local" : Uses NON_PROD_CONFIG (for local development)
# - "prod"  : Uses PROD_CONFIG (for production/master branch)

# Middleware A/B experiments (optional). Unset: control variant, no events sent.
# Use NEXT_PUBLIC_ prefix so the browser can read them (maps to MW_EVENTS_URL / MW_KEY).
NEXT_PUBLIC_MW_EVENTS_URL=
NEXT_PUBLIC_MW_KEY=
